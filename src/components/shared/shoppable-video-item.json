{
  "collectionName": "components_shared_shoppable_video_items",
  "info": {
    "displayName": "ShoppableVideoItem",
    "description": "Single shoppable video item with media and linked product."
  },
  "options": {},
  "attributes": {
    "delivery_channels": {
      "type": "enumeration",
      "enum": ["WEB", "APP", "BOTH", "NONE"],
      "default": "BOTH"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "video": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["videos"]
    },
    "preview_video": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["videos"]
    },
    "preview_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "product": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product.product"
    }
  }
}

