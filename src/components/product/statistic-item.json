{
  "collectionName": "components_product_statistic_items",
  "info": {
    "displayName": "StatisticItem",
    "description": "Single statistic with percentage and description."
  },
  "options": {},
  "attributes": {
    "delivery_channels": {
      "type": "enumeration",
      "enum": ["WEB", "APP", "BOTH", "NONE"],
      "default": "BOTH"
    },
    "percentage": {
      "type": "decimal"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    }
  }
}

